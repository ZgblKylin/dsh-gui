{
  "name": "dsh-ai-update",
  "description": "dsh-gui AI update bridge: the desktop shell posts a dsh-gui:ai-update window message and this browser half starts a fresh session from the requested agent preset with a prefilled composer prompt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "gui": {
      "mountId": "ai-update"
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "Unlicense",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}

{
  "name": "dsh-opencode-session",
  "description": "Injects the OpenCode per-conversation x-opencode-session header on LLM requests the loop does not stamp (auto-review and other hand-built auxiliary calls), clearing the opencode-go 400 MissingSessionID rejection; a stopgap until upstream deepseek-harness#5495 lands",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "gui": {
      "mountId": "opencode-session"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsdown && node --test tests/"
  },
  "license": "Unlicense",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  }
}
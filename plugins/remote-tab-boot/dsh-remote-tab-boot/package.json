{
  "name": "dsh-remote-tab-boot",
  "description": "Child-side bootstrap for remote desktop tabs: opens the remote Host workspace named by DSH_REMOTE_TAB_TARGET through ds-harness-remote's client service, then prints the supervisor sentinel; inert in any profile without the variable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "node tests/boot.spec.ts"
  },
  "license": "Unlicense",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  }
}

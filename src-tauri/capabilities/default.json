{
  "identifier": "default",
  "description": "Capability for the main webview window. Window controls and the About dialog use app-defined commands (no ACL plugin permissions required); every connection tab is hosted by a child webview that loads the harness page (or a remote dsh server) as a top-level document. The shell page runs on the app origin (Local context); tab webviews run on loopback harness ports, hence the remote URL pattern.",
  "windows": [
    "main",
    "dialog-conn",
    "dialog-update",
    "dialog-changelog",
    "dialog-about"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "snap-layout:default",
    "allow-minimize-window",
    "allow-toggle-maximize-window",
    "allow-is-window-maximized",
    "allow-close-window",
    "allow-start-window-drag",
    "allow-show-window-menu",
    "allow-show-config-menu",
    "allow-harness-url",
    "allow-about-info",
    "allow-local-update-projects",
    "allow-cached-update-status",
    "allow-remote-call",
    "allow-check-updates",
    "allow-start-update",
    "allow-update-root",
    "allow-update-changelog",
    "allow-shell-log",
    "allow-open-dialog",
    "allow-close-dialog",
    "allow-fit-dialog",
    "allow-show-dialog",
    "allow-connection-added",
    "allow-ai-update-request",
    "allow-dialog-event",
    "allow-view-create",
    "allow-view-set-bounds",
    "allow-view-set-visible",
    "allow-view-close",
    "allow-view-eval",
    "allow-page-theme",
    "allow-ai-update-result"
  ]
}

# ── Local toolchain / package caches (installed into the project, not globally) ──
# Repo-local pnpm store: the "local install cache" every build writes into.
.pnpm-store/
# Bootstrap toolchain (pinned pnpm installed by `npm run setup`).
.toolchain/
# Any stray node_modules at the repo root.
node_modules/
# Temporary npm cache (used by `npm run setup` to bootstrap the toolchain).
.npm-tmp-cache/
# Scratch: ad-hoc smoke scripts / probe bundles / throwaway cargo target dirs.
.work/
# Persistent upgrade-validation workspace: a clone of this repository plus every
# submodule, where a plugin/harness upgrade is built and smoke-tested before it
# is applied here. Maintained by scripts/staging.mjs; never a source of truth.
.staging/
# Desktop packaging download caches (Electron runtime, electron-builder tools)
# kept in the workspace because the sandbox denies writing %LOCALAPPDATA%.
.cache/
npm.log

# ── Tauri / Rust build output (entry exe lives here, but is never committed) ──
src-tauri/target/
src-tauri/gen/
src-tauri/permissions/autogenerated/
# Entry binary the build copies to the repository root (dsh-gui.exe on
# Windows, dsh-gui on Linux/macOS), plus the crash log the console-less
# Windows exe writes next to itself.
/dsh-gui.exe
/dsh-gui
/dsh-gui-crash.log

# ── Harness runtime ──
# npm-mode dsh CLI installed from the registry (harness.json runtime "npm");
# the source-mode runtime is the deepseek-harness submodule instead.
.harness/
# Harness runtime home (DSH_HOME is pinned to ./.dsh so profiles, plugins,
# agent presets, sessions, and logs stay inside the repository).
.dsh/

# ── OS / editor noise ──
Thumbs.db
.DS_Store
.idea/
.vscode/
*.user
